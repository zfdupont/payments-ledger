# Postgres
DATABASE_URL=postgres://ledger:changeme@localhost:5432/ledger?sslmode=disable

# Redpanda (Kafka API)
KAFKA_BROKERS=localhost:9092
OUTBOX_TOPIC=ledger.events

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ledger

# Auth
OAUTH_ISSUER_URL=http://localhost:8081
OAUTH_AUDIENCE=payments-ledger
API_KEY_PEPPER=changeme

# External ingestion source
INGEST_API_BASE_URL=https://example.invalid
INGEST_API_TOKEN=changeme
INGEST_RATE_LIMIT_RPS=5

# HTTP
HTTP_ADDR=:8080
